**PROCEDURE: main
**BEGIN: RTL Statements
	iLoad:       v0 <- 5            ;; Loading 5 in v0 to indicate syscall to read integter value
	read                            ;; This is where syscall will be made
	store:       a_ <- v0           ;; Moving the read value from register v0
	iLoad:       v0 <- 1            ;; Loading 1 in v0 to indicate syscall to print integter value
	load:        a0 <- a_           ;; Moving the value to be printed into register a0
	write                           ;; This is where syscall will be made
	iLoad:       v0 <- 10           ;; Loading integer number 10
	iLoad:       t1 <- 20           ;; Loading integer number 20
	add:         t0 <- v0 , t1
	iLoad:       v0 <- 1            ;; Loading 1 in v0 to indicate syscall to print integter value
	move:        a0 <- t0           ;; Moving the value to be printed into register a0
	write                           ;; This is where syscall will be made
	iLoad:       v0 <- 4            ;; Loading 4 in v0 to indicate syscall to print string value
	load:        a0 <- s_           ;; Moving the value to be printed into register a0
	write                           ;; This is where syscall will be made
	load:        v0 <- b_           ;; Loading variable b_ into register
	not:         t0 <- v0
	bgtz:        t0 , Label0
	load_addr:   v0 <- _str_0       ;; String = "sadjkf"
	store:       stemp0 <- v0
	goto:        Label1

  Label0:      
	load_addr:   v0 <- _str_1       ;; String = "asdklfh"
	store:       stemp0 <- v0

  Label1:      
	iLoad:       v0 <- 4            ;; Loading 4 in v0 to indicate syscall to print string value
	load:        a0 <- stemp0       ;; Moving the value to be printed into register a0
	write                           ;; This is where syscall will be made
	iLoad:       v0 <- 7            ;; Loading 7 in v0 to indicate syscall to read double value
	read                            ;; This is where syscall will be made
	store.d:     f_ <- f0           ;; Moving the read value from register f0
	iLoad:       v0 <- 3            ;; Loading 3 in v0 to indicate syscall to print double value
	load.d:      f12 <- f_          ;; Moving the value to be printed into register f12
	write                           ;; This is where syscall will be made
	iLoad.d:     f2 <- 10.00        ;; Loading float number 10.000000
	iLoad.d:     f6 <- 20.00        ;; Loading float number 20.000000
	add.d:       f4 <- f2 , f6
	iLoad:       v0 <- 3            ;; Loading 3 in v0 to indicate syscall to print double value
	move.d:      f12 <- f4
	write                           ;; This is where syscall will be made
**END: RTL Statements
