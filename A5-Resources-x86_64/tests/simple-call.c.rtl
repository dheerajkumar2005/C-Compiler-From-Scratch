**PROCEDURE: foo_
**BEGIN: RTL Statements
	iLoad:       v0 <- 10           ;; Loading integer number 10
	store:       stemp0 <- v0
	goto:        Label0

  Label0:      
	load:        v1 <- stemp0       ;; Moving the value to be printed into register v1
	return      v1
**END: RTL Statements
**PROCEDURE: main
**BEGIN: RTL Statements
	v1 = call foo_
	move:        v0 <- v1
	store:       a_ <- v0
**END: RTL Statements
