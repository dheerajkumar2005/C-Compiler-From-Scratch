**PROCEDURE: aello_
**BEGIN: RTL Statements
	load_addr:   v0 <- _str_2       ;; String = " cello"
	store:       s_ <- v0
**END: RTL Statements
**PROCEDURE: main
**BEGIN: RTL Statements
	iLoad:       v0 <- 1            ;; Loading integer number 1
	store:       a_ <- v0
	load_addr:   v0 <- _str_0       ;; String = "hello"
	store:       e_ <- v0
	load_addr:   v0 <- _str_1       ;; String = "fello"
	store:       f_ <- v0
	iLoad:       v0 <- 1            ;; Loading integer number 1
	store:       b_ <- v0
**END: RTL Statements
**PROCEDURE: zello_
**BEGIN: RTL Statements
	load_addr:   v0 <- _str_3       ;; String = "kello"
	store:       k_ <- v0
**END: RTL Statements
