**PROCEDURE: foo_
**BEGIN: RTL Statements
	iLoad:       v0 <- 10           ;; Loading integer number 10
	store:       stemp0 <- v0
	goto:        Label0

  Label0:      
	load:        v1 <- stemp0       ;; Moving the value to be printed into register v1
	return      v1
**END: RTL Statements
**PROCEDURE: main
**BEGIN: RTL Statements
	iLoad.d:     f2 <- 2.00         ;; Loading float number 2.000000
	push:        f2                 ;; Push parameter onto stack
	iLoad:       v0 <- 10           ;; Loading integer number 10
	push:        v0                 ;; Push parameter onto stack
	v1 = call foo_
	pop                             ;; Pop parameter 10 from stack 
	pop                             ;; Pop parameter 2.00 from stack 
	move:        v0 <- v1
	store:       a_ <- v0
**END: RTL Statements
