**PROCEDURE: main
**BEGIN: RTL Statements
	load:        v0 <- b1_          ;; Loading variable b1_ into register
	not:         t0 <- v0
	bgtz:        t0 , Label0
	load:        v0 <- b_           ;; Loading variable b_ into register
	store:       stemp0 <- v0
	goto:        Label1

  Label0:      
	load:        v0 <- c_           ;; Loading variable c_ into register
	store:       stemp0 <- v0

  Label1:      
	load:        v0 <- x_           ;; Loading variable x_ into register
	load:        t1 <- stemp0       ;; Loading variable stemp0 into register
	mul:         t0 <- v0 , t1
	uminus:      v0 <- t0
	move:        t0 <- v0           ;; Moving the value from v0 into a new register 
	iLoad:       v0 <- 1            ;; Loading 1 in v0 to indicate syscall to print integter value
	move:        a0 <- t0           ;; Moving the value to be printed into register a0
	write                           ;; This is where syscall will be made
	load:        v0 <- x_           ;; Loading variable x_ into register
	load:        t1 <- y_           ;; Loading variable y_ into register
	add:         t0 <- v0 , t1
	store:       z_ <- t0
	load:        v0 <- x_           ;; Loading variable x_ into register
	load:        t1 <- y_           ;; Loading variable y_ into register
	sub:         t0 <- v0 , t1
	store:       z_ <- t0
	load:        v0 <- x_           ;; Loading variable x_ into register
	load:        t1 <- y_           ;; Loading variable y_ into register
	mul:         t0 <- v0 , t1
	store:       z_ <- t0
	load:        v0 <- x_           ;; Loading variable x_ into register
	load:        t1 <- y_           ;; Loading variable y_ into register
	div:         t0 <- v0 , t1
	store:       z_ <- t0
	load.d:      f2 <- p_           ;; Loading variable p_ into register
	load.d:      f6 <- q_           ;; Loading variable q_ into register
	add.d:       f4 <- f2 , f6
	store.d:     r_ <- f4
	load.d:      f2 <- p_           ;; Loading variable p_ into register
	load.d:      f6 <- q_           ;; Loading variable q_ into register
	sub.d:       f4 <- f2 , f6
	store.d:     r_ <- f4
	load.d:      f2 <- p_           ;; Loading variable p_ into register
	load.d:      f6 <- q_           ;; Loading variable q_ into register
	mul.d:       f4 <- f2 , f6
	store.d:     r_ <- f4
	load.d:      f2 <- p_           ;; Loading variable p_ into register
	load.d:      f6 <- q_           ;; Loading variable q_ into register
	div.d:       f4 <- f2 , f6
	store.d:     r_ <- f4
	load:        v0 <- b1_          ;; Loading variable b1_ into register
	not:         t0 <- v0
	store:       b3_ <- t0
	load:        v0 <- b1_          ;; Loading variable b1_ into register
	load:        t1 <- b2_          ;; Loading variable b2_ into register
	and:         t0 <- v0 , t1
	store:       b3_ <- t0
	load:        v0 <- b1_          ;; Loading variable b1_ into register
	load:        t1 <- b2_          ;; Loading variable b2_ into register
	or:          t0 <- v0 , t1
	store:       b3_ <- t0
	load:        v0 <- x_           ;; Loading variable x_ into register
	load:        t1 <- y_           ;; Loading variable y_ into register
	slt:         t0 <- v0 , t1
	store:       b1_ <- t0
	load:        v0 <- x_           ;; Loading variable x_ into register
	load:        t1 <- y_           ;; Loading variable y_ into register
	sle:         t0 <- v0 , t1
	store:       b1_ <- t0
	load:        v0 <- x_           ;; Loading variable x_ into register
	load:        t1 <- y_           ;; Loading variable y_ into register
	sgt:         t0 <- v0 , t1
	store:       b1_ <- t0
	load:        v0 <- x_           ;; Loading variable x_ into register
	load:        t1 <- y_           ;; Loading variable y_ into register
	sge:         t0 <- v0 , t1
	store:       b1_ <- t0
	load:        v0 <- x_           ;; Loading variable x_ into register
	load:        t1 <- y_           ;; Loading variable y_ into register
	seq:         t0 <- v0 , t1
	store:       b1_ <- t0
	load:        v0 <- x_           ;; Loading variable x_ into register
	load:        t1 <- y_           ;; Loading variable y_ into register
	sne:         t0 <- v0 , t1
	store:       b1_ <- t0
	load:        v0 <- a_           ;; Loading variable a_ into register
	load:        t1 <- b_           ;; Loading variable b_ into register
	add:         t0 <- v0 , t1
	load:        v0 <- c_           ;; Loading variable c_ into register
	load:        t2 <- d_           ;; Loading variable d_ into register
	add:         t1 <- v0 , t2
	mul:         v0 <- t0 , t1
	store:       x_ <- v0
	load.d:      f2 <- p_           ;; Loading variable p_ into register
	load.d:      f4 <- q_           ;; Loading variable q_ into register
	slt.d:       f2 , f4
	iLoad:       v0 <- 1
	move:        t0 <- zero
	movt:        t0 <- v0 , 0
	store:       b1_ <- t0
	load.d:      f2 <- p_           ;; Loading variable p_ into register
	load.d:      f4 <- q_           ;; Loading variable q_ into register
	sle.d:       f2 , f4
	iLoad:       v0 <- 1
	move:        t0 <- zero
	movt:        t0 <- v0 , 0
	store:       b1_ <- t0
	load.d:      f2 <- p_           ;; Loading variable p_ into register
	load.d:      f4 <- q_           ;; Loading variable q_ into register
	sle.d:       f2 , f4            ;; Negating the condition and using le for gt, lt for ge, and eq for neq, for float values
	                                ;; because gt, ge, and neq operations are not supported by the coprocessor
	iLoad:       v0 <- 1
	move:        t0 <- zero
	movf:        t0 <- v0 , 0
	store:       b1_ <- t0
	load.d:      f2 <- p_           ;; Loading variable p_ into register
	load.d:      f4 <- q_           ;; Loading variable q_ into register
	slt.d:       f2 , f4            ;; Negating the condition and using le for gt, lt for ge, and eq for neq, for float values
	                                ;; because gt, ge, and neq operations are not supported by the coprocessor
	iLoad:       v0 <- 1
	move:        t0 <- zero
	movf:        t0 <- v0 , 0
	store:       b1_ <- t0
	load.d:      f2 <- p_           ;; Loading variable p_ into register
	load.d:      f4 <- q_           ;; Loading variable q_ into register
	seq.d:       f2 , f4            ;; Negating the condition and using le for gt, lt for ge, and eq for neq, for float values
	                                ;; because gt, ge, and neq operations are not supported by the coprocessor
	iLoad:       v0 <- 1
	move:        t0 <- zero
	movf:        t0 <- v0 , 0
	store:       b1_ <- t0
	load.d:      f2 <- p_           ;; Loading variable p_ into register
	load.d:      f4 <- q_           ;; Loading variable q_ into register
	seq.d:       f2 , f4
	iLoad:       v0 <- 1
	move:        t0 <- zero
	movt:        t0 <- v0 , 0
	store:       b1_ <- t0
**END: RTL Statements
