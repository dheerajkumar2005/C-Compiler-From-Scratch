**PROCEDURE: bar_
**BEGIN: RTL Statements
	iLoad:       v0 <- 10
	store:       a_ <- v0
**END: RTL Statements
**PROCEDURE: foo_
**BEGIN: RTL Statements
	load:        v0 <- y_
	load:        t1 <- bb_
	and:         t0 <- v0 , t1
	load:        v0 <- x_
	iLoad:       t2 <- 1
	sgt:         t1 <- v0 , t2
	load.d:      f2 <- z_
	iLoad.d:     f4 <- 10.00
	slt.d:       f2 , f4
	iLoad:       v0 <- 1
	move:        t2 <- zero
	movt:        t2 <- v0 , 0
	and:         v0 <- t1 , t2
	or:          t1 <- t0 , v0
	not:         v0 <- t1
	bgtz:        v0 , Label2
	iLoad.d:     f2 <- 10.00
	store.d:     stemp1 <- f2
	goto:        Label3

  Label2:      
	load.d:      f2 <- z_
	iLoad.d:     f6 <- 4.00
	mul.d:       f4 <- f2 , f6
	store.d:     stemp1 <- f4

  Label3:      
	load.d:      f2 <- stemp1
	store.d:     stemp0 <- f2
	goto:        Label0

  Label0:      
	load.d:      f0 <- stemp0
	return      f0
**END: RTL Statements
**PROCEDURE: foobar_
**BEGIN: RTL Statements
	iLoad:       v0 <- 69
	store:       stemp0 <- v0
	goto:        Label1

  Label1:      
	load:        v1 <- stemp0
	return      v1
**END: RTL Statements
**PROCEDURE: main
**BEGIN: RTL Statements
	iLoad:       v0 <- 1
	iLoad:       t1 <- 2
	slt:         t0 <- v0 , t1
	iLoad.d:     f2 <- 20.00
	push:        f2
	push:        t0
	iLoad:       v0 <- 1
	push:        v0
	f0 = call foo_
	pop          
	pop          
	pop          
	move.d:      f2 <- f0
	store.d:     f_ <- f2
	iLoad:       v0 <- 1
	load:        t1 <- x_
	add:         t0 <- v0 , t1
	load:        v0 <- x_
	iLoad:       t2 <- 2
	slt:         t1 <- v0 , t2
	load.d:      f2 <- f_
	iLoad.d:     f6 <- 20.25
	add.d:       f4 <- f2 , f6
	push:        f4
	push:        t1
	push:        t0
	f0 = call foo_
	pop          
	pop          
	pop          
	move.d:      f2 <- f0
	store.d:     f_ <- f2
	iLoad:       v0 <- 1
	load:        t1 <- x_
	add:         t0 <- v0 , t1
	load:        v0 <- x_
	iLoad:       t2 <- 2
	slt:         t1 <- v0 , t2
	load.d:      f2 <- f_
	iLoad.d:     f6 <- 20.25
	add.d:       f4 <- f2 , f6
	push:        f4
	push:        t1
	push:        t0
	call bar_
	pop          
	pop          
	pop          
	iLoad:       v0 <- 1
	load:        t1 <- x_
	add:         t0 <- v0 , t1
	load:        v0 <- x_
	iLoad:       t2 <- 2
	slt:         t1 <- v0 , t2
	load.d:      f2 <- f_
	iLoad.d:     f6 <- 20.25
	add.d:       f4 <- f2 , f6
	push:        f4
	push:        t1
	push:        t0
	v1 = call foobar_
	pop          
	pop          
	pop          
	move:        v0 <- v1
	store:       x_ <- v0
**END: RTL Statements
