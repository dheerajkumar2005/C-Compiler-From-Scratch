**PROCEDURE: foo_
**BEGIN: RTL Statements
	iLoad.d:     f2 <- 10.00
	store.d:     stemp0 <- f2
	goto:        Label0

  Label0:      
	load.d:      f0 <- stemp0
	return      f0
**END: RTL Statements
**PROCEDURE: main
**BEGIN: RTL Statements
	f0 = call foo_
	move.d:      f2 <- f0
	store.d:     f_ <- f2
**END: RTL Statements
