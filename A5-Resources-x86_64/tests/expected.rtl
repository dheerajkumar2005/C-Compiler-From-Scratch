**PROCEDURE: main
**BEGIN: RTL Statements
	load:        v0 <- b1_
	iLoad:       t1 <- 100
	add:         t0 <- v0 , t1
	store:       a1_ <- t0
	iLoad:       v0 <- 1
	load:        a0 <- a1_
	write        
	load.d:      f2 <- a2_
	iLoad.d:     f6 <- 200.00
	add.d:       f4 <- f2 , f6
	store.d:     b2_ <- f4
**END: RTL Statements
