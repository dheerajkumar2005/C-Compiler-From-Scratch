**PROCEDURE: foo_
**BEGIN: RTL Statements
	iLoad:       v0 <- 1
	store:       stemp0 <- v0
	goto:        Label0

  Label0:      
	load:        v1 <- stemp0
	return      v1
**END: RTL Statements
**PROCEDURE: main
**BEGIN: RTL Statements
	v1 = call foo_
	move:        v0 <- v1
	store:       k_ <- v0
	iLoad:       v0 <- 0
	store:       stemp0 <- v0
	goto:        Label1

  Label1:      
	load:        v1 <- stemp0
	return      v1
**END: RTL Statements
