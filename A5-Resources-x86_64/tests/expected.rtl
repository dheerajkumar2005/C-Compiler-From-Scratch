**PROCEDURE: foo_
**BEGIN: RTL Statements
	iLoad:       v0 <- 100
	store:       a_ <- v0
	iLoad:       v0 <- 2
	load:        t1 <- a_
	mul:         t0 <- v0 , t1
	store:       b_ <- t0
	load:        v0 <- a_
	load:        t1 <- b_
	add:         t0 <- v0 , t1
	store:       c_ <- t0
	load:        v0 <- a_
	load:        t1 <- b_
	mul:         t0 <- v0 , t1
	load:        t1 <- c_
	add:         v0 <- t0 , t1
	store:       stemp0 <- v0
	goto:        Label1

  Label1:      
	load:        v1 <- stemp0
	return      v1
**END: RTL Statements
**PROCEDURE: main
**BEGIN: RTL Statements
	iLoad:       v0 <- 1
	iLoad:       t1 <- 2
	add:         t0 <- v0 , t1
	store:       a_ <- t0
	iLoad:       v0 <- 1
	iLoad:       t1 <- 2
	add:         t0 <- v0 , t1
	store:       stemp0 <- t0
	goto:        Label0

  Label0:      
	load:        v1 <- stemp0
	return      v1
**END: RTL Statements
