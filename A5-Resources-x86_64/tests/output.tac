**PROCEDURE: main
**BEGIN: Three Address Code Statements
read a_
read b_
read c_
read d_
read e_
read f_
read g_
read h_
temp0 = a_ + b_
temp1 = c_ - d_
temp2 = temp0 * temp1
temp3 = e_ + f_
temp4 = g_ - h_
temp5 = temp3 * temp4
temp6 = - temp5
temp7 = temp2 / temp6
ans_ = temp7
write ans_
Label0: 
return stemp0

**END: Three Address Code Statements
