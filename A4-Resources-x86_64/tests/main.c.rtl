**PROCEDURE: main
**BEGIN: RTL Statements

  Label0:      
	load:        v0 <- x_       ;; Loading variable x_ into register
	not:         t0 <- v0
	bgtz:        t0 , Label1
	load:        v0 <- b_       ;; Loading variable b_ into register
	store:       a_ <- v0
	goto:        Label0

  Label1:      
**END: RTL Statements
