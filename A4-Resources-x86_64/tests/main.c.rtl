**PROCEDURE: main
**BEGIN: RTL Statements
	load:        v0 <- e_           
	load:        t1 <- f_           
	slt:         t0 <- v0 , t1
	not:         v0 <- t0
	bgtz:        v0 , Label0
	load:        v0 <- b_           
	load:        t1 <- g_           
	add:         t0 <- v0 , t1
	store:       stemp0 <- t0
	goto:        Label1

  Label0:      
	load:        v0 <- c_           
	load:        t1 <- g_           
	mul:         t0 <- v0 , t1
	load:        t1 <- d_           
	add:         v0 <- t0 , t1
	store:       stemp0 <- v0

  Label1:      
	load:        v0 <- i_           
	load:        t1 <- stemp0       
	mul:         t0 <- v0 , t1
	uminus:      v0 <- t0
	move:        t0 <- v0           
	iLoad:       v0 <- 1            
	move:        a0 <- t0           
	write                           
	load:        v0 <- bb_          
	not:         t0 <- v0
	bgtz:        t0 , Label2
	load:        v0 <- b_           
	store:       stemp1 <- v0
	goto:        Label3

  Label2:      
	load:        v0 <- c_           
	store:       stemp1 <- v0

  Label3:      
	load:        v0 <- i_           
	load:        t1 <- stemp1       
	mul:         t0 <- v0 , t1
	uminus:      v0 <- t0
	move:        t0 <- v0           
	iLoad:       v0 <- 1            
	move:        a0 <- t0           
	write                           
**END: RTL Statements
