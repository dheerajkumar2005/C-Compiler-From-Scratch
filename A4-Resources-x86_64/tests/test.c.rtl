**PROCEDURE: main
**BEGIN: RTL Statements
	load_addr:   v0 <- _str_0       
	store:       s1_ <- v0
	load_addr:   v0 <- _str_0       
	store:       s2_ <- v0
	load_addr:   v0 <- _str_1       
	store:       s2_ <- v0
	iLoad:       v0 <- 1            
	iLoad:       t1 <- 2            
	slt:         t0 <- v0 , t1
	not:         v0 <- t0
	bgtz:        v0 , Label0
	load:        v0 <- s1_          
	store:       stemp0 <- v0
	goto:        Label1

  Label0:      
	load:        v0 <- s2_          
	store:       stemp0 <- v0

  Label1:      
	load:        v0 <- stemp0       
	store:       s3_ <- v0
**END: RTL Statements
